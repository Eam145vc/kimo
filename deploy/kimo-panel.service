[Unit]
Description=Kimo Panel Web - Skiimo Cocktails
After=network.target kimo.service

[Service]
Type=simple
User=kimo
Group=kimo
WorkingDirectory=/srv/kimo
EnvironmentFile=/srv/kimo/.env
Environment=PANEL_HOST=0.0.0.0
Environment=PANEL_PORT=8080
ExecStart=/srv/kimo/.venv/bin/python -m skiimo.panel.app
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kimo-panel

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/kimo/data /srv/kimo/logs

[Install]
WantedBy=multi-user.target
